{
  "name": "random-pass",
  "version": "0.7.1",
  "private": true,
  "description": "A simple random string generator to better passwords",
  "scripts": {
    "serve": "vite preview",
    "dev": "vite --host",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint --ext .js,.vue,.cjs src tests",
    "lint:fix": "eslint --ext .js,.vue,.cjs --fix src tests",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons-vue": "^0.7.0",
    "vue": "^3.5.39",
    "vue-clipboard2": "0.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "cypress": "^15.20.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vite": "6.4.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "keywords": [
    "string",
    "random"
  ],
  "resolutions": {
    "eslint/**/brace-expansion": "^1.1.18",
    "eslint/**/js-yaml": "^4.3.1",
    "**/postcss": "^8.5.23",
    "**/nanoid": "^3.3.17"
  }
}
